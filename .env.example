# API JWT 签名密钥
JWT_SECRET=replace-with-a-long-random-secret

# MinIO 管理员凭证； 实际.env中请使用自己的高强度密码
MINIO_ROOT_USER=cloudbox-admin
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password

# PostgreSQL 管理员与应用连接凭证
POSTGRES_USER=cloudbox
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=cloudbox

# Redis 缓存访问密码
REDIS_PASSWORD=replace-with-a-long-random-password

# JSON 请求日志的最低输出级别：debug、info、warn 或 error
LOG_LEVEL=info

# 回收站文件自动永久删除的保留时间，单位小时；0 表示禁用
TRASH_RETENTION_HOURS=0

# 链路追踪导出器: none 表示关闭；stdout 将 Span 输出到应用标准输出
TRACE_EXPORTER=none

# 后台任务 Worker 数量：0 表示禁用， 默认 1
JOB_WORKER_COUNT=1

# Worker 队列为空时的轮询间隔，单位毫秒
JOB_POLL_INTERVAL_MILLISECONDS=1000